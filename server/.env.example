# Copie ce fichier en .env (optionnel) pour surcharger la config.
PORT=4000
JWT_SECRET=change-moi-en-prod

# Clé API Anthropic par défaut (facultatif).
# Chaque utilisateur peut aussi saisir sa propre clé dans Profil > Réglages.
# Sans clé, ClassMemo bascule sur un générateur heuristique local.
ANTHROPIC_API_KEY=

# Notifications push (facultatif). Génère une paire de clés avec :
#   npm -w server run vapid
# puis colle les deux valeurs ici (et dans l'env Render en prod).
# Sans ces clés, les rappels de révision push sont désactivés.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:contact@classmemo.app
# Fuseau horaire des rappels (par défaut : Africa/Kinshasa).
REMINDER_TZ=Africa/Kinshasa
