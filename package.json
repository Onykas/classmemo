{
  "name": "classmemo",
  "version": "1.0.0",
  "private": true,
  "description": "ClassMemo — compagnon de révision collaborative pour petites tablées d'étude",
  "workspaces": [
    "server",
    "web"
  ],
  "engines": {
    "node": ">=22.5"
  },
  "scripts": {
    "dev": "concurrently -k -n SERVER,WEB -c green,cyan \"npm:dev:server\" \"npm:dev:web\"",
    "dev:server": "npm -w server run dev",
    "dev:web": "npm -w web run dev",
    "seed": "npm -w server run seed",
    "build": "npm -w web run build",
    "start": "npm -w server run start"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
